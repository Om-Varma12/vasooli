# PostgreSQL database connection (psycopg2 & SQLAlchemy async format)
DATABASE_URL=postgresql://postgres:password@localhost:5432/vasooli
DB_HOST=localhost
DB_PORT=5432
DATABASE=vasooli
DB_USER=postgres

# Razorpay Integration credentials & Webhook secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_API_KEY=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Redis Connection (optional - falls back to in-memory store if unavailable)
REDIS_URL=redis://localhost:6379/0

# Groq API Key for LLM Classification & Whisper transcription
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_LLM_MODEL=qwen/qwen3-8b

# Twilio Voice & WhatsApp API credentials
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SANDBOX_NUMBER=+14155238886
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WHATSAPP_TO=+910000000000
TEST_NUMBER=+910000000000
TWILIO_CONTENT_SID=HX_your_twilio_content_sid
TWILIO_VOICE_FROM=+10000000000
VOICE_BASE_URL=https://your-ngrok-tunnel.ngrok-free.app
